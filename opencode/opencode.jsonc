{
  "$schema": "https://opencode.ai/config.json",
  // custom provider example
  /*
  "providers": {
    "my-provider": {
      "name": "My AI",
      "env": ["MY_AI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible", // npm package name of the provider SDK
      "settings": {
        "baseURL": "https://api.my-ai.example/v1", // baseURL can only be set per provider, not per model
      },
      "models": {
        "my-model": {
          "name": "My Model",
          "limit": { // set token limits for this model
            "context": 1000000,
            "output": 65535
          },
        },
      },
    },
  },
  */
  // https://opencode.ai/v2/docs/permissions
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
    { "action": "shell", "resource": "cargo fmt *", "effect": "allow" },
    { "action": "shell", "resource": "cargo test *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "false", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "ask" }, // Can be dangerous with -exec.
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git remote show *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "glab auth status", "effect": "allow" },
    { "action": "shell", "resource": "glab issue list *", "effect": "allow" },
    { "action": "shell", "resource": "glab issue view *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "openspec *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },

    // Prompt for paths outside the active project/worktree.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],
  "mcp": {
    "servers": {
      "glab": {
        "type": "local",
        "command": [
          "glab",
          "mcp",
          "serve"
        ],
        "disabled": true
      },
      "adrs": {
        "type": "local",
        "command": [
          "adrs",
          "mcp",
          "serve"
        ],
        "disabled": true
      }
    }
  }
}
